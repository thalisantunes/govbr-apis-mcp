# Copy to .env (git-ignored) or set in the MCP client's env block.
# Each key's signup_url lives in the catalog entry (see README).

# Portal da Transparência (free, gov.br login): https://api.portaldatransparencia.gov.br/
TRANSPARENCIA_API_KEY=

# CNJ DataJud (public key published at https://datajud-wiki.cnj.jus.br/api-publica/acesso)
DATAJUD_API_KEY=

# dados.gov.br portal API (free, generated in user profile)
DADOSGOV_API_KEY=

# Serpro commercial APIs — credentials issued per contracted API (loja.serpro.gov.br)
SERPRO_CPF_CLIENT_ID=
SERPRO_CPF_CLIENT_SECRET=
SERPRO_CNPJ_CLIENT_ID=
SERPRO_CNPJ_CLIENT_SECRET=
SERPRO_DATAVALID_CLIENT_ID=
SERPRO_DATAVALID_CLIENT_SECRET=

# Validador da CIE (meia-entrada) — codigoAcesso de estabelecimento/produtora
# Cadastro: https://www.meiaentrada.org.br/validador/integre
MEIAENTRADA_CODIGO_ACESSO=
